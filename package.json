{
  "name": "jarvis-local",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "packages/shared-types"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ollama": "node scripts/dev.mjs ollama",
    "dev:desktop": "npm run dev --workspace apps/desktop",
    "typecheck": "npm run typecheck --workspace apps/desktop",
    "build": "npm run build --workspace apps/desktop",
    "dev:agent": "node scripts/dev.mjs agent",
    "dev:agent:reload": "node scripts/dev.mjs agent-reload",
    "test:startup": "node --test tests/startup/startup.test.cjs"
  }
}
