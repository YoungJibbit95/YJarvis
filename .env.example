# Optional overrides
# Optional executable path only (no command-line arguments). When unset, the
# launcher prefers .venv/Scripts/python.exe on Windows or .venv/bin/python on POSIX.
# JARVIS_PYTHON_BIN=python3.11
JARVIS_AGENT_HOST=127.0.0.1
JARVIS_AGENT_PORT=8787
JARVIS_DB_PATH=runtime/jarvis.db
WHISPER_MODEL=runtime/models/ggml-small.bin
JARVIS_PROFILE_PATH=runtime/jarvis_profile.json
JARVIS_OLLAMA_KEEP_ALIVE=30m
JARVIS_HISTORY_LIMIT=6
JARVIS_MEMORY_LIMIT=1
JARVIS_ENABLE_TOOL_PLANNER=0
JARVIS_TOOL_SUMMARY_VIA_LLM=0
JARVIS_WHISPER_BEAM_SIZE=5
JARVIS_WHISPER_BEST_OF=5
JARVIS_WHISPER_NO_SPEECH_THOLD=0.70
JARVIS_WHISPER_ENTROPY_THOLD=2.10
JARVIS_WHISPER_LOGPROB_THOLD=-0.60
JARVIS_PIPER_LENGTH_SCALE=0.80
JARVIS_PIPER_NOISE_SCALE=0.80
JARVIS_PIPER_NOISE_W_SCALE=0.88
JARVIS_PIPER_SENTENCE_SILENCE=0.03
JARVIS_PIPER_VOLUME=1.10
JARVIS_PIPER_USE_PYTHON_API=1
JARVIS_SAY_RATE_WPM=220
JARVIS_TTS_SIR_PRONUNCIATION=Sör
JARVIS_TOKEN_FLUSH_INTERVAL_MS=20
JARVIS_TOKEN_FLUSH_MIN_CHARS=8
JARVIS_AUDIO_TMP_KEEP=30
JARVIS_TTS_TMP_KEEP=20
JARVIS_TMP_MAX_AGE_SECONDS=43200
